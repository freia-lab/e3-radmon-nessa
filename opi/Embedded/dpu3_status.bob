  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <file>dpu3_devid.bob</file>
        <target>window</target>
        <description>Open Display</description>
      </action>
    </actions>
    <text>Device ID</text>
    <x>7</x>
    <y>120</y>
    <width>70</width>
    <height>32</height>
    <rules>
      <rule name="Vis" prop_id="visible" out_exp="false">
        <exp bool_exp="pvStr0 = &quot;012345&quot;">
          <value>false</value>
        </exp>
        <pv_name>$(PREFIX)sDevCommSer</pv_name>
      </rule>
    </rules>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group</name>
    <macros>
      <PV_NAME>$(PREFIX)sString</PV_NAME>
    </macros>
    <x>9</x>
    <y>10</y>
    <width>467</width>
    <height>22</height>
    <style>3</style>
