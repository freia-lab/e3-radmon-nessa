      <x>210</x>
      <width>255</width>
    </widget>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(pv_name).PROC</pv_name>
        <value>1</value>
        <description>Reset Acc. Dose</description>
      </action>
    </actions>
    <pv_name>$(PREFIX)AccDoseRst</pv_name>
    <x>7</x>
    <y>170</y>
    <width>70</width>
    <height>58</height>
    <tooltip>$(actions)</tooltip>
    <show_confirm_dialog>true</show_confirm_dialog>
  </widget>
