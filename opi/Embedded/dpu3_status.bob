<?xml version="1.0" encoding="UTF-8"?>
<!--Saved on 2024-11-29 17:15:42 by konrad-->
<display version="2.0.0">
  <name>Nessa status</name>
  <width>500</width>
  <height>250</height>
  <background_color>
    <color name="OK" red="61" green="216" blue="61">
    </color>
  </background_color>
  <rules>
    <rule name="BackgroundColor" prop_id="background_color" out_exp="false">
      <exp bool_exp="pv0 &gt; pv2">
        <value>
          <color name="ERROR" red="252" green="13" blue="27">
          </color>
        </value>
      </exp>
      <exp bool_exp="pv0 &gt; pv1">
        <value>
          <color name="WARNING" red="252" green="242" blue="17">
          </color>
        </value>
      </exp>
      <pv_name>$(PREFIX)sDoseRt</pv_name>
      <pv_name>$(PREFIX)sThr1</pv_name>
      <pv_name>$(PREFIX)sThr2</pv_name>
    </rule>
  </rules>
  <widget type="group" version="3.0.0">
    <name>Group_16</name>
